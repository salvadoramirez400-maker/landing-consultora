# Password de Postgres usado por docker-compose para inicializar el servicio `db`
# y para armar el DSN que recibe el servicio `web`.
POSTGRES_PASSWORD=

# Opcional: solo si corres Flask fuera de Docker contra otra base.
# Dentro de docker-compose esta variable la arma `web` automáticamente:
# postgres://app:${POSTGRES_PASSWORD}@db:5432/landing_consultora
POSTGRES_URL=

# Clave para firmar sesiones de Flask. Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Admins en texto plano: "user:password,user:password"
# Ejemplo: ADMIN_USERS=administrador:MiClaveSecreta,salvador_ramirez:OtraClave
ADMIN_USERS=

# Email para Let's Encrypt (solo lo usa docker-compose.prod.yml con Traefik).
# Let's Encrypt avisa a esta dirección si un certificado está por vencer o falla.
ACME_EMAIL=
